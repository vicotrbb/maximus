h 2*count+2 inclusive\", budgets=\"1 and max(count,1)\", checks=\"one-step returned sums, full maps, and final cursors equal; measured state sum matches expected visited entries after warmup+timing\", cases=1134), root_tool_observed_run=dict(exit=0, exec_session=1033), inference=\"Repeated range_mut initialization/search plausibly contributes to the 256-stream full-budget slowdown; no profile or isolated cost measurement establishes its cause.\", limits=[\"No product edits or actual Connection::poll test; independent model equivalence does not establish engine scheduling correctness.\", \"No HTTP throughput, socket latency, allocation-counter, retained-memory or RSS claim.\", \"ns_per_operation is per model poll; stream visit counts differ by budget and are not the printed denominator.\", \"One standalone process, six fixed cases and seven alternating pairs; all slower samples remain present.\", \"Raw elapsed timestamps, exact rustc invocation/optimization flags, CPU affinity and immutable execution image are not independently recorded in these files.\", \"Source/executable hashes record supplied provenance but alone cannot prove the executable was compiled from this exact source.\"], artifact_sha256={str(p.relative_to(ROOT)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(observed)}, analysis_script=Path(__file__).read_text())\n(OUT / \"stream-schedule-model-evidence.json\").write_text(json.dumps(result, indent=2) + \"\\n\")\nfor filename, data in [(\"stream-schedule-model-trials.csv\", records), (\"stream-schedule-model-pairs.csv\", pairs)]:\n    with (OUT / filename).open(\"w\") as output:\n        writer = csv.DictWriter(output, fieldnames=list(data[0]))\n        writer.writeheader()\n        writer.writerows(data)\nprint(json.dumps({\"source_sha256\":result[\"source_sha256\"], \"timed_model_poll_operations\":result[\"timed_model_poll_operations\"], \"summaries\":summaries}, indent=2))\n"
