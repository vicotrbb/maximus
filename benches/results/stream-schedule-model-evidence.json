  "compiler_metadata": "rustc 1.96.1 (31fca3adb 2026-06-26)\nbinary: rustc\ncommit-hash: 31fca3adb283cc9dfd56b49cdee9a96eb9c96ffd\ncommit-date: 2026-06-26\nhost: aarch64-unknown-linux-gnu\nrelease: 1.96.1\nLLVM version: 22.1.2\n01769a13e115047d7bd56807d0cc464c38cde587b2951dd010157462a2e0a8b8  /target/stream-schedule-probe\n",
  "embedded_source": "//! Standard-library traversal model, not an HTTP engine benchmark.\nuse std::{collections::BTreeMap, hint::black_box, ops::Bound, time::Instant};\ntype Map = BTreeMap<u32, u64>;\ntype Step = fn(&mut Map, &mut u32, usize) -> u64;\nfn snapshot(map: &mut Map, cursor: &mut u32, budget: usize) -> u64 {\n    let ids: Vec<_> = map\n        .range((Bound::Excluded(*cursor), Bound::Unbounded))\n        .chain(map.range(..=*cursor))\n        .map(|(&id, _)| id)\n        .collect();\n    let mut sum = 0u64;\n    for id in ids.into_iter().take(budget) {\n        let value = map.get_mut(&id).unwrap();\n        *value = value.wrapping_add(1);\n        sum = sum.wrapping_add(*value);\n        *cursor = id;\n    }\n    sum\n}\nfn live(map: &mut Map, cursor: &mut u32, budget: usize) -> u64 {\n    let count = map.len();\n    let ceiling = map.last_key_value().map_or(0, |(&id, _)| id);\n    let mut next_cursor = *cursor;\n    let mut sum = 0u64;\n    for _ in 0..count.min(budget) {\n        let lower = if next_cursor < ceiling {\n            Bound::Excluded(next_cursor)\n        } else {\n            Bound::Unbounded\n        };\n        let (&id, value) = map.range_mut((lower, Bound::Unbounded)).next().unwrap();\n        next_cursor = id;\n        *value = value.wrapping_add(1);\n        sum = sum.wrapping_add(*value);\n        *cursor = id;\n    }\n    sum\n}\nfn map(count: usize) -> Map {\n    (0..count).map(|i| (i as u32 * 2 + 1, 0)).collect()\n}\nfn measure(round: usize, count: usize, budget: usize, mode: &str, step: Step) {\n    let operations = (1_000_000 / count.min(budget).max(1)).max(2000);\n    let mut state = map(count);\n    let mut cursor = 0;\n    let step = black_box(step);\n    for _ in 0..1000 {\n        black_box(step(&mut state, &mut cursor, budget));\n    }\n    let started = Instant::now();\n    for _ in 0..operations {\n        black_box(step(\n            black_box(&mut state),\n            black_box(&mut cursor),\n            black_box(budget),\n        ));\n    }\n    let elapsed = started.elapsed();\n    assert_eq!(\n        state.values().sum::<u64>(),\n        (operations + 1000) as u64 * count.min(budget) as u64\n    );\n    println!(\n        \"{round},{count},{budget},{mode},{operations},{:.3}\",\n        elapsed.as_nanos() as f64 / operations as f64\n    );\n}\nfn main() {\n    for count in [0, 1, 3, 16, 256] {\n        for cursor in 0..=count as u32 * 2 + 2 {\n            for budget in [1, count.max(1)] {\n                let mut old = map(count);\n                let mut new = old.clone();\n                let mut before = cursor;\n                let mut after = cursor;\n                assert_eq!(\n                    snapshot(&mut old, &mut before, budget),\n                    live(&mut new, &mut after, budget)\n                );\n                assert_eq!(old, new);\n                assert_eq!(before, after);\n            }\n        }\n    }\n    println!(\"round,streams,budget,mode,operations,ns_per_operation\");\n    let cases = [(0, 1), (1, 1), (16, 1), (16, 16), (256, 1), (256, 256)];\n    for round in 0..7 {\n        for (count, budget) in cases {\n            if round % 2 == 0 {\n                measure(round, count, budget, \"snapshot\", snapshot);\n                measure(round, count, budget, \"live\", live);\n            } else {\n                measure(round, count, budget, \"live\", live);\n                measure(round, count, budget, \"snapshot\", snapshot);\n            }\n        }\n    }\n}\n",
